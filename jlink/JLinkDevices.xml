<?xml version="1.0" encoding="UTF-8"?>
<!--
  SEGGER J-Link device definition for the ML63Q2537 (ROHM/Lapis Solist-AI).

  The MCU is not in the J-Link built-in device database, so the flash bank is
  described here and driven by the vendor CMSIS flash algorithm ML63Q25x7.FLM
  (taken verbatim from ROHM.ML63Q25x7_DFP 0.4.0, Flash/ML63Q25x7.FLM).

  The algorithm runs on the target: its Init() raises the system clock to the
  48 MHz PLL, Erase*/ProgramPage drive FLASHA/FLASHD/FLASHCON/FLASHACP/FLASHSLF
  and clear the watchdog while polling FLASHSTA. That is the same sequence the
  OpenOCD TCL in openocd/openocd.cfg performs one word at a time over
  SWD, except here it executes at full core speed out of RAM.

  Flash geometry reported by the algorithm's FlashDevice descriptor:
    base 0x10000000, size 0x40000, page 0x400, sector (erase unit) 0x800.

  Loader paths are resolved relative to this file.
-->
<DataBase>
  <Device>
    <ChipInfo Vendor="ROHM"
              Name="ML63Q2537"
              Core="JLINK_CORE_CORTEX_M0"
              WorkRAMAddr="0x20000000"
              WorkRAMSize="0x4000"/>
    <FlashBankInfo Name="Internal Flash"
                   BaseAddr="0x10000000"
                   MaxSize="0x40000"
                   Loader="ML63Q25x7.FLM"
                   LoaderType="FLASH_ALGO_TYPE_OPEN"
                   AlwaysPresent="1"/>
  </Device>
</DataBase>
